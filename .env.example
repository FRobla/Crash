# Copy to .env.local and adjust. Never commit real .env files.
#
# Optional custom Solana devnet RPC endpoint (https only). Defaults to https://api.devnet.solana.com.
# NEXT_PUBLIC_* values are inlined into the browser bundle: any API key here is public.
# The app only supports devnet; an endpoint serving another cluster is reported as "wrong network".
NEXT_PUBLIC_SOLANA_RPC_URL=
#
# Optional live channel of the operator crank (ADR 0004; presentation only): stops the curve at the
# real crash point instead of up to ~3 s later. https, or http to localhost only. For local play
# with `pnpm operator` (which serves it on 127.0.0.1:8787 by default):
#   NEXT_PUBLIC_CRASH_LIVE_FEED_URL=http://127.0.0.1:8787/events
# Without it the web reads the chain only.
NEXT_PUBLIC_CRASH_LIVE_FEED_URL=
