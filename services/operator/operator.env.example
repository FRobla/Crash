# Operator crank settings (docs/specs/crash-client-v1.md §4). Copy to `.env.operator` in the repo
# root (git-ignored). Server-only: never prefix these with NEXT_PUBLIC_.
#
# Both paths must be OUTSIDE the repository; the crank refuses to start otherwise.
# From Windows, the WSL CLI keypair (devnet only) is reachable through the WSL share. Wrap Windows
# paths in single quotes so the backslashes are kept, e.g.
#   CRASH_OPERATOR_KEYPAIR='\\wsl.localhost\Ubuntu-24.04\root\.config\solana\id.json'
CRASH_OPERATOR_KEYPAIR=
# Unrevealed seeds are written here (one file per round) and deleted after the reveal.
CRASH_OPERATOR_STATE_DIR=
# Optional https devnet RPC; defaults to https://api.devnet.solana.com.
CRASH_OPERATOR_RPC_URL=
# Optional: pause after each round (ms, default 3000), priority fee (micro-lamports/CU,
# default 1000) and poll interval (ms, default 800).
CRASH_OPERATOR_PAUSE_MS=
CRASH_OPERATOR_PRIORITY_FEE=
CRASH_OPERATOR_POLL_MS=
